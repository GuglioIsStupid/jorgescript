SET NAME TO "FUCKKKKKKK";
SET COUNT TO 101;
SET FLAG TO TRUE!;
SET UNTRUEFLAG TO Untrue...;
SET BALLS TO "FUCK YOU SWORD";
ALWAYS SET GODMODE TO FLAG;

PRINT NAME;
PRINT UNTRUEFLAG;
IF FLAG::IS(TRUE!) THEN {
    PRINT "Godmode is " + GODMODE;
}

PRINT 10 > 4;
PRINT 10 < 4;
PRINT 10 == 10;
PRINT 10 != 4;
PRINT 10 >= 10;
PRINT 4 <= 10;

PRINT 5 + 5;
PRINT 5 - 5;
PRINT 5 * 5;
PRINT 5 % 5;
PRINT 5 / 2;
PRINT 5 // 2;

LOADDLL "user32.dll" AS USER32;

CALL USER32::MessageBoxW(
    0,
    "HELLO FROM JORGESCRIPT",
    "JORGE",
    0
);