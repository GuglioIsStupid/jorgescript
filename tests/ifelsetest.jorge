SUMMON "STD.TESTS";

SET V TO 2;
SET RESULT TO "NONE";

IF (V == 1) THEN {
    SET RESULT TO "IF";
} ELSE IF (V == 2) THEN {
    SET RESULT TO "ELSEIF";
} ELSE {
    SET RESULT TO "ELSE";
}

PRINT TESTS::ASSERT_EQ(RESULT, "ELSEIF");

SET V TO 99;
SET RESULT TO "NONE";

IF (V == 1) THEN {
    SET RESULT TO "IF";
} ELSE IF (V == 2) THEN {
    SET RESULT TO "ELSEIF";
} ELSE {
    SET RESULT TO "ELSE";
}

PRINT TESTS::ASSERT_EQ(RESULT, "ELSE");
