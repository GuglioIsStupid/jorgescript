SUMMON "STD.IO";
SUMMON "STD.STRING";
SUMMON "STD.TESTS";

SET CURRENT_PATH TO IO::GET_CURRENT_PATH();
PRINT TESTS::ASSERT_EQ(STRING::CONTAINS(CURRENT_PATH, "iotests.jorge"), TRUE!, "IO GET_CURRENT_PATH points to main script");

SET TARGET TO "io_tmp.txt";

PRINT TESTS::ASSERT_EQ(IO::WRITE_FILE(TARGET, "alpha"), TRUE!, "WRITE_FILE returns true");
PRINT TESTS::ASSERT_EQ(IO::EXISTS(TARGET), TRUE!, "EXISTS after write");
PRINT TESTS::ASSERT_EQ(IO::READ_FILE(TARGET), "alpha", "READ_FILE returns written content");
PRINT TESTS::ASSERT_EQ(IO::FILE_SIZE(TARGET), 5, "FILE_SIZE after initial write");

PRINT TESTS::ASSERT_EQ(IO::APPEND_FILE(TARGET, "beta"), TRUE!, "APPEND_FILE returns true");
PRINT TESTS::ASSERT_EQ(IO::READ_FILE(TARGET), "alphabeta", "READ_FILE after append");
PRINT TESTS::ASSERT_EQ(IO::FILE_SIZE(TARGET), 9, "FILE_SIZE after append");
