SUMMON "STD.MATH";
SUMMON "STD.TESTS";

PRINT TESTS::ASSERT_EQ(MATH::ABS(-12), 12);
PRINT TESTS::ASSERT_EQ(MATH::MIN(10, 4), 4);
PRINT TESTS::ASSERT_EQ(MATH::MAX(10, 4), 10);
PRINT TESTS::ASSERT_EQ(MATH::CLAMP(15, 0, 10), 10);

PRINT TESTS::ASSERT_EQ(MATH::FLOOR(4.9), 4);
PRINT TESTS::ASSERT_EQ(MATH::FLOOR(-4.1), -5);
PRINT TESTS::ASSERT_EQ(MATH::CEIL(4.1), 5);
PRINT TESTS::ASSERT_EQ(MATH::CEIL(-4.9), -4);
PRINT TESTS::ASSERT_EQ(MATH::ROUND(3.49), 3);
PRINT TESTS::ASSERT_EQ(MATH::ROUND(3.5), 4);
PRINT TESTS::ASSERT_EQ(MATH::ROUND(-3.5), -4);

PRINT TESTS::ASSERT_EQ(MATH::SIGN(-8), -1);
PRINT TESTS::ASSERT_EQ(MATH::SIGN(0), 0);
PRINT TESTS::ASSERT_EQ(MATH::SIGN(8), 1);

PRINT TESTS::ASSERT_EQ(MATH::SQRT(25), 5);
PRINT TESTS::ASSERT_EQ(MATH::POW(2, 10), 1024);
PRINT TESTS::ASSERT_EQ(MATH::POW(2, -3), 0.125);

PRINT TESTS::ASSERT_EQ(MATH::ABS(MATH::SIN(1.5707963267948966) - 1) < 0.001, TRUE!);
PRINT TESTS::ASSERT_EQ(MATH::ABS(MATH::COS(0) - 1) < 0.001, TRUE!);
PRINT TESTS::ASSERT_EQ(MATH::ABS(MATH::TAN(0)) < 0.001, TRUE!);

PRINT TESTS::ASSERT_EQ(MATH::ABS(MATH::ASIN(1) - 1.5707963267948966) < 0.01, TRUE!);
PRINT TESTS::ASSERT_EQ(MATH::ABS(MATH::ACOS(1)) < 0.01, TRUE!);
PRINT TESTS::ASSERT_EQ(MATH::ABS(MATH::ATAN(1) - 0.7853981633974483) < 0.02, TRUE!);
PRINT TESTS::ASSERT_EQ(MATH::ABS(MATH::ATAN2(1, 1) - 0.7853981633974483) < 0.02, TRUE!);

PRINT TESTS::ASSERT_EQ(MATH::ABS(MATH::EXP(1) - 2.718281828459045) < 0.02, TRUE!);
PRINT TESTS::ASSERT_EQ(MATH::ABS(MATH::LOG(2.718281828459045) - 1) < 0.02, TRUE!);
PRINT TESTS::ASSERT_EQ(MATH::ABS(MATH::LOG10(1000) - 3) < 0.02, TRUE!);

SET BADROOT TO MATH::SQRT(-1);
PRINT TESTS::ASSERT_EQ(BADROOT, NOTHING);

SET BADLOG TO MATH::LOG(0);
PRINT TESTS::ASSERT_EQ(BADLOG, NOTHING);
